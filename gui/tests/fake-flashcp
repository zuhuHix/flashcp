#!/bin/sh
# Fake flashcp for tests and dry runs. Speaks the JSON-lines contract, writes nothing.
# FAKE_FLASHCP_FAIL=1 makes it emit an error event and exit 2.
# FAKE_FLASHCP_LOG=<file> appends the received argv (one arg per line, then "--").
if [ -n "$FAKE_FLASHCP_LOG" ]; then for a in "$@"; do printf '%s\n' "$a"; done >> "$FAKE_FLASHCP_LOG"; echo -- >> "$FAKE_FLASHCP_LOG"; fi
op="$1"
case "$op" in
  info)
    echo '{"label":"FAKEUSB","cluster":32768,"size":32010928128,"free":30000000000,"files":12,"dirs":3,"dirty":false}'
    exit 0 ;;
  add|build) ;;
  *) echo "{\"event\":\"error\",\"message\":\"unknown op $op\"}"; exit 2 ;;
esac
if [ "$FAKE_FLASHCP_FAIL" = "1" ]; then
  echo '{"event":"plan","op":"'"$op"'","files":10,"dirs":2,"bytes":1000000,"write_bytes":1100000}'
  echo '{"event":"error","message":"fake failure: device busy"}'
  exit 2
fi
echo '{"event":"plan","op":"'"$op"'","files":100,"dirs":5,"bytes":50000000,"write_bytes":52000000}'
i=1
while [ $i -le 10 ]; do
  sleep "${FAKE_FLASHCP_DELAY:-0.05}"
  echo '{"event":"progress","files_done":'$((i*10))',"bytes_done":'$((i*5000000))'}'
  i=$((i+1))
done
echo '{"event":"done","files":100,"bytes":50000000,"secs":0.5}'
