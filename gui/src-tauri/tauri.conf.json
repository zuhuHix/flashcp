{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flashcp-gui",
  "mainBinaryName": "flashcp-gui",
  "version": "0.3.1",
  "identifier": "io.github.zuhuhix.flashcp.gui",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": { "script": "cargo build --release --locked -p flashcp-helper", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "flashcp — fast copy to USB",
        "width": 520,
        "height": 680,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Fast copy to USB drives with flashcp",
    "longDescription": "Tray app for flashcp: notices USB exFAT drives, offers a fast one-pass copy to a drive, and copies folders back from a USB drive. Adds \"Fast copy to USB (flashcp)\" and \"Fast copy from USB (flashcp)\" to the Nemo, Nautilus and Dolphin context menus.",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/zuhuHix/flashcp",
    "publisher": "zuhu",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["flashcp", "pkexec | policykit-1", "udisks2", "xdg-utils", "fuse3"],
        "recommends": ["libnotify-bin", "python3-nautilus"],
        "section": "utils",
        "desktopTemplate": "../../packaging/desktop/flashcp-gui.desktop",
        "files": {
          "/usr/libexec/flashcp-helper": "../target/release/flashcp-helper",
          "/usr/libexec/flashcp-trust": "../target/release/flashcp-trust",
          "/usr/share/polkit-1/actions/io.github.zuhuhix.flashcp.trust.policy": "../../packaging/desktop/io.github.zuhuhix.flashcp.trust.policy",
          "/usr/share/polkit-1/actions/io.github.zuhuhix.flashcp.helper.policy": "../../packaging/desktop/io.github.zuhuhix.flashcp.helper.policy",
          "/etc/xdg/autostart/flashcp-gui.desktop": "../../packaging/desktop/flashcp-gui-autostart.desktop",
          "/usr/share/nemo/actions/flashcp.nemo_action": "../../packaging/desktop/flashcp.nemo_action",
          "/usr/share/nemo/actions/flashcp-pull.nemo_action": "../../packaging/desktop/flashcp-pull.nemo_action",
          "/usr/share/nautilus-python/extensions/flashcp_nautilus.py": "../../packaging/desktop/flashcp_nautilus.py",
          "/usr/share/kio/servicemenus/flashcp.desktop": "../../packaging/desktop/flashcp-dolphin.desktop",
          "/usr/share/kio/servicemenus/flashcp-pull.desktop": "../../packaging/desktop/flashcp-dolphin-pull.desktop",
          "/usr/share/icons/hicolor/scalable/apps/flashcp-gui.svg": "../../packaging/desktop/flashcp-gui.svg",
          "/usr/share/doc/flashcp-gui/SECURITY-NOTES.md": "../../packaging/desktop/SECURITY-NOTES.md",
          "/usr/libexec/flashcp-mountpoint": "../target/release/flashcp-mountpoint",
          "/usr/libexec/flashcp-udev-check": "../target/release/flashcp-udev-check",
          "/usr/share/polkit-1/actions/io.github.zuhuhix.flashcp.mountpoint.policy": "../../packaging/desktop/io.github.zuhuhix.flashcp.mountpoint.policy",
          "/usr/lib/udev/rules.d/61-flashcp-drive-mode.rules": "../../packaging/desktop/61-flashcp-drive-mode.rules",
          "/usr/lib/systemd/user/flashcp-drived.service": "../../packaging/desktop/flashcp-drived.service",
          "/usr/lib/systemd/user-preset/80-flashcp-drived.preset": "../../packaging/desktop/80-flashcp-drived.preset"
        },
        "postInstallScript": "../../packaging/desktop/deb-postinst.sh",
        "preRemoveScript": "../../packaging/desktop/deb-prerm.sh",
        "postRemoveScript": "../../packaging/desktop/deb-postrm.sh"
      }
    }
  }
}
