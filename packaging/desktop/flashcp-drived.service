[Unit]
Description=flashcp drive mode: serve USB exFAT drives through flashcp
Documentation=https://github.com/zuhuHix/flashcp/blob/main/packaging/desktop/README.md
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/bin/flashcp drived
Restart=on-failure
RestartSec=2
# SIGTERM goes to the daemon only: it flushes and unmounts every drive (each driver gets exactly
# one SIGTERM from it), then exits. Whatever is left after the timeout is killed.
KillMode=mixed
TimeoutStopSec=90
# Whatever happened to the daemon, new drives go to udisks again until it runs.
ExecStopPost=/bin/rm -f %t/flashcp/drive-mode-on

[Install]
WantedBy=default.target
