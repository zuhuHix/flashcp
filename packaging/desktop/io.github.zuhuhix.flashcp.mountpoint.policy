<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>flashcp</vendor>
  <vendor_url>https://github.com/zuhuHix/flashcp</vendor_url>
  <icon_name>flashcp-gui</icon_name>

  <!-- Install to /usr/share/polkit-1/actions/. pkexec only runs /usr/libexec/flashcp-mountpoint
       under this action. The program only creates or removes an empty directory
       /media/<caller>/<NAME> owned by the caller, so an active local session gets it without a
       password, the same level as udisks' own filesystem-mount (see SECURITY-NOTES.md). -->
  <action id="io.github.zuhuhix.flashcp.mountpoint">
    <description>Create a mount point for a USB drive</description>
    <message>Authentication is required to create a mount point under /media</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/flashcp-mountpoint</annotate>
  </action>
</policyconfig>
