<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>flashcp</vendor>
  <vendor_url>https://github.com/zuhuHix/flashcp</vendor_url>
  <icon_name>flashcp-gui</icon_name>

  <!-- Install to /usr/share/polkit-1/actions/. pkexec only runs /usr/libexec/flashcp-trust
       under this action. Trusting a drive is a lasting decision, so every request needs a fresh
       administrator authentication: auth_admin everywhere, never auth_admin_keep
       (see SECURITY-NOTES.md). -->
  <action id="io.github.zuhuhix.flashcp.trust">
    <description>Trust a USB drive for flashcp</description>
    <message>Authentication is required to let flashcp write to this USB drive in the future</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/flashcp-trust</annotate>
  </action>
</policyconfig>
