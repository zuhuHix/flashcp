#!/usr/bin/env python3
"""A stand-in for `flashcp mount` that speaks docs/drive-mode-interface.md (proto 1) without
FUSE, for the drive-daemon integration tests. Scenario per device: DEV + ".mode" may hold
`busy` or `crash` (SIGKILL itself after mounting, every start). `--check` refuses anything without
an exFAT boot signature. Control: status, flush, prepare-eject, resume, unmount, and the test-only
`fake-dirty N` (pretend N bytes are pending)."""
import json, os, signal, socket, sys, threading, time

def out(**o):
    print(json.dumps(o), flush=True)

args = sys.argv[1:]
assert args[0] == "mount", args
dev = args[-1] if "--check" in args else args[1]
mode = open(dev + ".mode").read().strip() if os.path.exists(dev + ".mode") else "ok"
with open(dev, "rb") as f:
    exfat = f.read(11)[3:11] == b"EXFAT   "
if mode == "busy":
    out(event="busy", device=dev); sys.exit(4)
if not exfat:
    out(event="refused", reason="not_exfat", message="no exFAT boot sector", device=dev, label=None, serial=None)
    sys.exit(3)
if "--check" in args:
    out(event="check", ok=True, reason=None, label="STICK", serial="1a2b3c4d", pending_journal=False); sys.exit(0)

mp, sock_path = args[2], args[args.index("--control") + 1]
starts = int(open(dev + ".starts").read()) + 1 if os.path.exists(dev + ".starts") else 1
open(dev + ".starts", "w").write(str(starts))
st = {"dirty": 0, "files": 0, "eject": False}
lock = threading.Lock()
done = threading.Event()

def commit(reason):
    with lock:
        if st["dirty"] or st["files"]:
            out(event="committing", bytes=st["dirty"], files=st["files"], reason=reason)
            time.sleep(0.2)
            out(event="committed", bytes=st["dirty"], files=st["files"], secs=0.2)
            st["dirty"] = st["files"] = 0
            out(event="dirty_bytes", bytes=0, files=0)

def finish(*_):
    commit("unmount")
    out(event="unmounted", clean=True)
    done.set()

def serve(conn):
    f = conn.makefile("rw")
    for line in f:
        cmd = line.split()
        if not cmd:
            continue
        r = {"ok": True}
        if cmd[0] == "status":
            r.update(proto=1, state="dirty" if st["dirty"] else "idle", dirty_bytes=st["dirty"], dirty_files=st["files"])
        elif cmd[0] == "flush":
            commit("flush"); r["state"] = "idle"
        elif cmd[0] == "prepare-eject":
            commit("eject"); st["eject"] = True; r["safe"] = True
        elif cmd[0] == "resume":
            st["eject"] = False
        elif cmd[0] == "fake-dirty":
            with lock:
                st["dirty"], st["files"] = int(cmd[1]), 1
            out(event="dirty_bytes", bytes=st["dirty"], files=1)
        elif cmd[0] == "unmount":
            f.write(json.dumps(r) + "\n"); f.flush(); finish(); return
        else:
            r = {"ok": False, "error": "unknown command"}
        f.write(json.dumps(r) + "\n"); f.flush()

if os.path.exists(sock_path):
    os.unlink(sock_path)
srv = socket.socket(socket.AF_UNIX); srv.bind(sock_path); srv.listen(4)
threading.Thread(target=lambda: [threading.Thread(target=serve, args=(srv.accept()[0],), daemon=True).start() for _ in iter(int, 1)], daemon=True).start()
signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=finish).start())
out(event="mounted", proto=1, device=dev, mountpoint=mp, label="STICK", serial="1a2b3c4d", size=1 << 26,
    free=1 << 25, cluster=4096, pid=os.getpid(), recovered="replayed" if starts > 1 else None)
if mode == "crash":
    time.sleep(0.2); os.kill(os.getpid(), signal.SIGKILL)
done.wait()
os.unlink(sock_path)
sys.exit(0)
